# Copy this file to MAILER/.env and replace placeholders locally.
# Never commit MAILER/.env or put real credentials in this example.
SENDER_EMAIL_1=sender@example.invalid
SENDER_PASSWORD_1=replace-with-local-secret
SMTP_SERVER_1=smtp.example.invalid
SMTP_PORT_1=465

# Live sending remains fail-closed unless separately authorized.
MAILFORGE_ALLOW_LIVE_SEND=0
